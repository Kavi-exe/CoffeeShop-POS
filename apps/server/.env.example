# Local POS server
PORT=8080
DATA_DIR=./data

# Auth — generate real secrets for production: `openssl rand -hex 32`
JWT_SECRET=change-me-64-hex-chars
JWT_REFRESH_SECRET=change-me-too-64-hex-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

# Cloud sync (optional; leave CLOUD_API_URL empty to run fully offline)
CLOUD_API_URL=http://localhost:8090
CLOUD_API_TOKEN=generate-a-long-random-token
CLOUD_DEVICE_ID=cafe-local-01
SYNC_INTERVAL_MS=5000
SYNC_BATCH_SIZE=200

# Printing: sink = network | file | cups
PRINT_SINK=file
PRINT_DIR=./data/print-jobs
PRINT_HISTORY_DIR=./data/print-history
