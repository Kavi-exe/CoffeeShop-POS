# Cloud API
PORT=8090
DATABASE_URL=postgres://brewbean:brewbean_dev@localhost:5432/brewbean_cloud

# Auth
JWT_SECRET=change-me-cloud-64-hex-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

# Device ingest token (must match CLOUD_API_TOKEN on the local server)
DEVICE_INGEST_TOKEN=generate-a-long-random-token

# Dashboard
CORS_ORIGINS=http://localhost:5174
OWNER_EMAIL=owner@brewbean.cafe
OWNER_PASSWORD=change-me-owner123
